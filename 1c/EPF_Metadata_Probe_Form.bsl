// Паллета — пробник метаданных УТ 11.5.20.97.
// МОДУЛЬ УПРАВЛЯЕМОЙ ФОРМЫ внешней обработки EPF.
// READ-ONLY: не создаёт документы, не проводит, не записывает регистры,
// не меняет конфигурацию и не обращается к GitHub.
// В форме создать реквизит РезультатДиагностики (Строка, неограниченная,
// многострочный), команду ПроверитьМетаданные и кнопку, связанную с командой.

&НаКлиенте
Процедура ПроверитьМетаданные(Команда)
    РезультатДиагностики = СобратьОтчетМетаданных();
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокИмен(Коллекция)
    Результат = Новый Массив;
    Для Каждого ЭлементМД Из Коллекция Цикл
        Результат.Добавить(ЭлементМД.Имя);
    КонецЦикла;
    Возврат СтрСоединить(Результат, ", ");
КонецФункции

&НаСервереБезКонтекста
Функция ВажноДляМеню(ИмяОбъекта)
    ИмяН = НРег(ИмяОбъекта);
    Возврат СтрНайти(ИмяН, "цен") > 0
        Или СтрНайти(ИмяН, "товар") > 0
        Или СтрНайти(ИмяН, "склад") > 0
        Или СтрНайти(ИмяН, "резерв") > 0
        Или СтрНайти(ИмяН, "номенклатур") > 0
        Или СтрНайти(ИмяН, "запас") > 0
        Или СтрНайти(ИмяН, "блокир") > 0
        Или СтрНайти(ИмяН, "wms") > 0;
КонецФункции

&НаСервереБезКонтекста
Функция СтруктураРегистра(ОбъектМД, ТипРегистра)
    С = ТипРегистра + "." + ОбъектМД.Имя + Символы.ПС;
    С = С + "  Измерения: " + СписокИмен(ОбъектМД.Измерения) + Символы.ПС;
    С = С + "  Ресурсы: " + СписокИмен(ОбъектМД.Ресурсы) + Символы.ПС;
    С = С + "  Реквизиты: " + СписокИмен(ОбъектМД.Реквизиты) + Символы.ПС;
    Возврат С;
КонецФункции

&НаСервереБезКонтекста
Функция СобратьОтчетМетаданных()
    Вывод = "ПАЛЛЕТА / UT11 Metadata Probe / READ ONLY" + Символы.ПС;
    Вывод = Вывод + "Время проверки: " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm:ss") + Символы.ПС;
    Вывод = Вывод + "Версия конфигурации: " + Метаданные.Версия + Символы.ПС;
    Вывод = Вывод + "Ключ CSV (НЕ GUID склада): PALLETA_TRADE_HALL" + Символы.ПС;
    Вывод = Вывод + "Контрольные коды поиска: 3202 (картофель), 1079 (рис Мистраль)" + Символы.ПС + Символы.ПС;

    Вывод = Вывод + "[1] СПРАВОЧНИКИ: НОМЕНКЛАТУРА, СКЛАДЫ, ВИДЫ ЦЕН" + Символы.ПС;
    Для Каждого СправочникМД Из Метаданные.Справочники Цикл
        Если ВажноДляМеню(СправочникМД.Имя)
            Или СтрНайти(НРег(СправочникМД.Имя), "видыц") > 0 Тогда
            Вывод = Вывод + "Справочник." + СправочникМД.Имя + Символы.ПС;
            Вывод = Вывод + "  Реквизиты: " + СписокИмен(СправочникМД.Реквизиты) + Символы.ПС;
        КонецЕсли;
    КонецЦикла;

    Вывод = Вывод + Символы.ПС + "[2] РЕГИСТРЫ СВЕДЕНИЙ — КАНДИДАТЫ" + Символы.ПС;
    Для Каждого РегистрМД Из Метаданные.РегистрыСведений Цикл
        Если ВажноДляМеню(РегистрМД.Имя) Тогда
            Вывод = Вывод + СтруктураРегистра(РегистрМД, "РегистрСведений");
        КонецЕсли;
    КонецЦикла;

    Вывод = Вывод + Символы.ПС + "[3] РЕГИСТРЫ НАКОПЛЕНИЯ — КАНДИДАТЫ" + Символы.ПС;
    Для Каждого РегистрМД Из Метаданные.РегистрыНакопления Цикл
        Если ВажноДляМеню(РегистрМД.Имя) Тогда
            Вывод = Вывод + СтруктураРегистра(РегистрМД, "РегистрНакопления");
        КонецЕсли;
    КонецЦикла;

    Вывод = Вывод + Символы.ПС
        + "[4] STOP: ЭТО НЕ ВЫГРУЗКА ЦЕН/ОСТАТКОВ" + Символы.ПС
        + "После проверки метаданных нужно подтвердить: источник Оптовая, RUB; "
        + "точную ссылку склада Паллета Петра 1; безопасный доступный остаток; "
        + "упаковки/характеристики. Эта обработка ничего не публикует." + Символы.ПС;
    Возврат Вывод;
КонецФункции
